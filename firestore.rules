rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public Gallery collection
    match /gallery/{photoId} {
      allow read: if true;
      allow create, update: if isValidId(photoId)
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.category is string && request.resource.data.category.size() <= 50
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 5000000;
      allow delete: if isValidId(photoId);
    }

    // Announcements collection for temple updates & time-sensitive notices
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isValidId(announcementId)
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.content is string && request.resource.data.content.size() <= 2000
        && request.resource.data.category is string && request.resource.data.category.size() <= 50;
      allow delete: if isValidId(announcementId);
    }

    // Deleted items registry
    match /deleted_photos/{photoId} {
      allow read, write: if true;
    }

    match /deleted_announcements/{announcementId} {
      allow read, write: if true;
    }

    // Admins registry collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if false;
    }

    // Catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
